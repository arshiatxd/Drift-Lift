                        <Setter Property="Source" Value="/Assets/Xbox/XB_Base.png"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPs5}" Value="True">
                                <Setter Property="Source" Value="/Assets/PS5/PS5_Base.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPs4}" Value="True">
                                <Setter Property="Source" Value="/Assets/PS4/PS4_Base.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsXbox360}" Value="True">
                                <Setter Property="Source" Value="/Assets/Xbox360/XB360_Base.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsXboxOne}" Value="True">
                                <Setter Property="Source" Value="/Assets/Xbox/XB_Base.png"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

