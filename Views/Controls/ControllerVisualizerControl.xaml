                            <MouseBinding Gesture="LeftClick" Command="{Binding RemapHotspotCommand}" CommandParameter="R3" />
                        </Image.InputBindings>
                    </Image>
                </Grid>
            </Canvas>
        </Canvas>
    </Grid>
</UserControl>