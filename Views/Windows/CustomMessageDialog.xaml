<Window x:Class="DriftLift.Views.Windows.CustomMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drift-Lift Notification" Height="220" Width="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">

    <Border x:Name="MainContainer"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource RedNeon}"
            BorderThickness="1"
            CornerRadius="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTrans" ScaleX="0.95" ScaleY="0.95"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="6,3" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="IconTxt" Text="ℹ" Foreground="{DynamicResource RedNeon}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleTxt" Text="DRIFT-LIFT NOTIFICATION" Foreground="{DynamicResource RedNeon}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource PopupCloseBtn}"/>
            </Grid>

            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <TextBlock x:Name="MessageTxt" Text="Message details go here." Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </ScrollViewer>

            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Content="OK" Click="Ok_Click" Style="{DynamicResource RedNeonBtn}" Padding="20,6" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="CancelBtn" Content="CANCEL" Click="Cancel_Click" Style="{DynamicResource DefaultButtonStyle}" Margin="10,0,0,0" Padding="16,6" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
