<Window x:Class="DriftLock.Views.Windows.PsLedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DriftLock.Views.Controls"
        Title="PlayStation LED Customization" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">

    <Border x:Name="MainContainer"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource RedNeon}"
            BorderThickness="1"
            CornerRadius="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTrans" ScaleX="0.95" ScaleY="0.95"/>
                <TranslateTransform x:Name="TranslateTrans" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ##== Header ==## -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="7,4" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="💡" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PLAYSTATION CONTROLLER LED LIGHTS" Foreground="{DynamicResource RedNeon}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Cursor="Hand" ToolTip="Close" Style="{DynamicResource DefaultButtonStyle}">
                    <TextBlock Text="✕" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ##== Circular Color Wheel & Swatches Section ==## -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:ColorWheelControl Grid.Column="0" x:Name="ColorWheel" Width="170" Height="170" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border Width="50" Height="50" CornerRadius="0" BorderThickness="2" Margin="0,0,0,12" x:Name="PreviewBorder" HorizontalAlignment="Left">
                        <Border x:Name="PreviewFill" CornerRadius="0" Background="#FF1744"/>
                    </Border>
                    <TextBlock Text="PRESET COLOR SWATCHES" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="SwatchesPanel">
                        <Border Width="22" Height="22" CornerRadius="0" Background="#FF1744" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#FF1744" ToolTip="Red"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#29B6F6" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#29B6F6" ToolTip="Electric Blue"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#E040FB" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#E040FB" ToolTip="Neon Purple"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#00E676" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#00E676" ToolTip="Neon Green"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#FFD600" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#FFD600" ToolTip="Neon Yellow"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#FFFFFF" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#FFFFFF" ToolTip="Bright White"/>
                        <Border Width="22" Height="22" CornerRadius="0" Background="#000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,4" Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="#000000" ToolTip="Off"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ##== Brightness Slider ==## -->
            <Border Grid.Row="2" Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="BRIGHTNESS" Foreground="{DynamicResource TextPrimary}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="BrightnessStatusText" Text="100% Bright" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                    </StackPanel>
                    <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="ColorSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="BrightnessValLbl" Text="100%" Foreground="{DynamicResource RedNeon}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ##== Action Buttons ==## -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="APPLY &amp; SAVE" Click="Apply_Click" Style="{DynamicResource RedNeonBtn}" Margin="0,0,10,0" Padding="18,8" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="CANCEL" Click="Cancel_Click" Style="{DynamicResource DefaultButtonStyle}" Padding="18,8" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
