<Window x:Class="DriftLock.Views.Windows.HidHidePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidHide Driver Required?" Height="310" Width="470"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Loaded="Window_Loaded">
    <Border x:Name="MainContainer"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource RedNeon}"
            BorderThickness="1"
            CornerRadius="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTrans" ScaleX="0.95" ScaleY="0.95"/>
                <TranslateTransform x:Name="TranslateTrans" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        
        <Grid Margin="22">
            <Grid x:Name="PromptGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="7,4" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="🛡️" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="HIDHIDE DRIVER NOT DETECTED" Foreground="{DynamicResource RedNeon}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="Continue_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Cursor="Hand" Style="{DynamicResource DefaultButtonStyle}">
                        <TextBlock Text="✕" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="HidHide driver is recommended to prevent double-input conflicts in games by hiding physical controllers while routing through Drift Lift's virtual Xbox controller." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                <Border Grid.Row="2" Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="12,8" VerticalAlignment="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Automatic download, installation, and zero-touch configuration." Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="DOWNLOAD &amp; INSTALL" Click="Download_Click" Style="{DynamicResource RedNeonBtn}" Margin="0,0,10,0" Padding="18,8" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="CONTINUE WITHOUT IT" Click="Continue_Click" Style="{DynamicResource DefaultButtonStyle}" Padding="18,8" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ProgressGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <Border Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="7,4" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SETTING UP HIDHIDE DRIVER" Foreground="{DynamicResource RedNeon}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                    <TextBlock x:Name="StatusLbl" Text="Downloading HidHide Driver..." Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Height="10" Background="{DynamicResource SubCardBg}" CornerRadius="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource RedNeon}" CornerRadius="0"/>
                    </Border>
                    <TextBlock x:Name="ProgressDetailsLbl" Text="Connecting..." Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ErrorLbl" Text="" Foreground="{DynamicResource RedNeon}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
                </StackPanel>
                <Button x:Name="ErrorContinueBtn" Grid.Row="2" Content="CONTINUE TO APP" Click="Continue_Click" Style="{DynamicResource RedNeonBtn}" HorizontalAlignment="Right" Padding="18,8" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>