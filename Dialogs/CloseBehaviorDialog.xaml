<Window x:Class="DriftLift.Dialogs.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close Application" Height="220" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource RedNeon}" BorderThickness="1" CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect Color="#FF1744" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Close DriftLift" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Grid.Row="1" Text="Would you like to minimize DriftLift to the system tray so your controller calibrations remain active in the background?" 
                       Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <CheckBox x:Name="RememberCheckBox" Grid.Row="2" Content="Remember my choice" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,8,0,16"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Minimize to Tray" Click="Minimize_Click" Style="{StaticResource RedNeonBtn}" Margin="0,0,10,0"/>
                <Button Content="Exit Completely" Click="Exit_Click" Background="#2A303F" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="14,8" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>