<Window x:Class="DriftLift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:DriftLift"
        xmlns:views="clr-namespace:DriftLift.Views"
        mc:Ignorable="d"
        Title="Drift Lift v1.0.7" Height="780" Width="1260"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Duration x:Key="SidebarDuration">0:0:0.22</Duration>
        <Style x:Key="FadeView" TargetType="UIElement">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="RadioButton" BasedOn="{DynamicResource NavButtonStyle}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubCardBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="0" Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1744"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BgDark}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            x:Name="RootBorder">
        <Border.Effect>
            <DropShadowEffect Color="#FF1744" BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <tb:TaskbarIcon x:Name="MyNotifyIcon"
                            IconSource="icon.ico"
                            ToolTipText="Drift Lift Controller Calibration"
                            TrayMouseDoubleClick="TrayIcon_DoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Background="{DynamicResource CardBg}"
                                 BorderBrush="{DynamicResource RedNeon}"
                                 BorderThickness="1">
                        <MenuItem Header="Open Drift Lift" Click="TrayRestore_Click" Foreground="{DynamicResource TextPrimary}"/>
                        <MenuItem Header="Run in Background" Click="TrayMinimize_Click" Foreground="{DynamicResource TextPrimary}"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="TrayExit_Click" Foreground="{DynamicResource RedNeon}"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
            <Border Grid.Row="0"
                    Background="{DynamicResource BgDark}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding AppLogoSource}" Width="28" Height="28" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DRIFT LIFT" FontWeight="Black" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="v1.0.7  ·  Controller Suite" Foreground="{DynamicResource TextMuted}" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SubCardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0" Padding="12,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PROFILE" Foreground="{DynamicResource RedNeon}" FontSize="10" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                      SelectedItem="{Binding CurrentProfile, Mode=TwoWay}"
                                      Style="{DynamicResource ProfileComboBox}"
                                      Width="170"/>
                            <Button Command="{Binding NewProfileCommand}" Content="+" Style="{DynamicResource HeaderIconBtn}" ToolTip="New Profile" Margin="6,0,0,0"/>
                            <Button Command="{Binding SaveProfileCommand}" Content="💾" Style="{DynamicResource HeaderIconBtn}" ToolTip="Save Profile" Margin="3,0,0,0"/>
                            <Button Command="{Binding ImportProfileCommand}" Content="📥" Style="{DynamicResource HeaderIconBtn}" ToolTip="Import Profile" Margin="3,0,0,0"/>
                            <Button Command="{Binding ExportProfileCommand}" Content="📤" Style="{DynamicResource HeaderIconBtn}" ToolTip="Export Profile" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{DynamicResource TitleBarBtn}" Command="{Binding OpenPsLedSettingsCommand}" ToolTip="RGB Controller LED Configuration" Margin="0,0,4,0">
                            <TextBlock Text="💡" FontSize="12"/>
                        </Button>
                        <Button Style="{DynamicResource TitleBarBtn}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Dark / Light Theme" Margin="0,0,4,0">
                            <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource TitleBarBtn}" Click="MinimizeBtn_Click" ToolTip="Minimize">
                            <TextBlock Text="─" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{DynamicResource TitleBarBtn}" Click="MaximizeBtn_Click" ToolTip="Maximize / Restore">
                            <TextBlock Text="▢" FontSize="11"/>
                        </Button>
                        <Button Style="{DynamicResource TitleBarCloseBtn}" Click="CloseBtn_Click" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" x:Name="SidebarCol"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        x:Name="SidebarBorder"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="SidebarToggle_Click"
                                Padding="0,14"
                                Margin="0,0,0,4"
                                ToolTip="Toggle Navigation Menu">
                            <Grid Width="180" HorizontalAlignment="Left">
                                <TextBlock Text="☰" FontSize="15" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Width="28" TextAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </Button>
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavHome" GroupName="NavMenu"
                                         IsChecked="True"
                                         Command="{Binding SelectTabCommand}" CommandParameter="0"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <TextBlock Text="⌂" FontSize="16" Width="28" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock x:Name="NavHomeLbl" Text="HOME" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavProfiles" GroupName="NavMenu"
                                         Command="{Binding SelectTabCommand}" CommandParameter="1"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <TextBlock Text="🎮" FontSize="14" Width="28" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock x:Name="NavProfilesLbl" Text="GAMES" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavRemap" GroupName="NavMenu"
                                         Command="{Binding SelectTabCommand}" CommandParameter="2"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconRemap4Buttons}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                    <TextBlock x:Name="NavRemapLbl" Text="REMAP" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavCalibrate" GroupName="NavMenu"
                                         Command="{Binding SelectTabCommand}" CommandParameter="3"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <TextBlock Text="◎" FontSize="16" Width="28" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock x:Name="NavCalibrateLbl" Text="CALIBRATE" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavMacros" GroupName="NavMenu"
                                         Command="{Binding SelectTabCommand}" CommandParameter="4"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <TextBlock Text="⚙" FontSize="16" Width="28" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock x:Name="NavMacrosLbl" Text="MACROS" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <Border Margin="6,0,6,4" Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="8,8" x:Name="DeviceInfoPanel">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Margin="0,0,8,0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ControllerConnectionIcon}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource RedNeon}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Ellipse Width="7" Height="7" Fill="{Binding ConnectionStatusColor}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,0"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceModelText}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DeviceFirmwareText}" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid Margin="6,0,6,0">
                                <Border x:Name="BatteryInfoPanelExpanded" Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="10,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔋" FontSize="15" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BatteryPercentageText}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                            <Border Width="110" Height="6" Background="{DynamicResource SubCardBg}" CornerRadius="0" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                <Border HorizontalAlignment="Left" Width="{Binding BatteryLevelWidth}" Background="{Binding BatteryFillColor}" CornerRadius="0"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BatteryInfoPanelCollapsed" Background="{DynamicResource SubCardBg}" CornerRadius="0" Padding="4,8" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" Width="48">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="20" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="6" Height="3" Background="{DynamicResource TextMuted}" CornerRadius="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            <Border Width="18" Height="23" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="0" Background="{DynamicResource CardBg}" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="{Binding BatteryLevelHeight}" Background="{Binding BatteryFillColor}" CornerRadius="0"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding BatteryPercentageShortText}" Foreground="{DynamicResource TextPrimary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <RadioButton x:Name="NavSettings" GroupName="NavMenu"
                                         Command="{Binding SelectTabCommand}" CommandParameter="5"
                                         Style="{DynamicResource NavButtonStyle}"
                                         Click="NavBtn_Click" Margin="0,8,0,0">
                                <Grid Width="180" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                    <TextBlock x:Name="NavSettingsLbl" Text="SETTINGS" VerticalAlignment="Center" Margin="48,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="14" x:Name="ContentGrid">
                    <views:HomeView x:Name="ViewHome"
                                    Opacity="0" IsHitTestVisible="False"/>
                    <views:ProfilesView x:Name="ViewProfiles"
                                        Opacity="0" IsHitTestVisible="False"/>
                    <views:RemapView x:Name="ViewRemap"
                                     Opacity="0" IsHitTestVisible="False"/>
                    <views:CalibrateView x:Name="ViewCalibrate"
                                         Opacity="0" IsHitTestVisible="False"/>
                    <views:MacrosView x:Name="ViewMacros"
                                      Opacity="0" IsHitTestVisible="False"/>
                    <views:SettingsView x:Name="ViewSettings"
                                        Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>