<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Arshiadxt.DriftLift"
    Publisher="CN=Arshiadxt"
    Version="1.0.1.0" />

  <Properties>
    <DisplayName>Drift Lift - Gamepad Controller Suite</DisplayName>
    <PublisherDisplayName>Arshiadxt</PublisherDisplayName>
    <Logo>Assets\Store\StoreLogo.png</Logo>
    <Description>Advanced Gamepad Calibration, Real-Time Anti-Drift Engine, Dual Controller Remapping (Xbox &amp; DualShock 4/PS5), and Double-Input Protection Suite.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="DriftliftApp.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Drift Lift"
        Description="Gamepad Controller Suite &amp; Anti-Drift Engine"
        BackgroundColor="#0F1117"
        Square150x150Logo="Assets\Store\Square150x150Logo.png"
        Square44x44Logo="Assets\Store\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Store\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Store\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
